<mxfile host="app.diagrams.net"><diagram name="Operation Quartzfang · how one preview API call became four hosts and an exfiltrated archive"><mxGraphModel dx="1200" dy="900" grid="0" background="#ffffff" page="1" pageWidth="1300" pageHeight="1456"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Operation Quartzfang · how one preview API call became four hosts and an exfiltrated archive" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#1d1d1f;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1100" height="34" as="geometry"/></mxCell><mxCell id="lg0" value="Attacker / outside" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#1d1d1f;fillColor=#fde8e8;strokeColor=#d70015;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="164" height="28" as="geometry"/></mxCell><mxCell id="lg1" value="sc-portal01" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#1d1d1f;fillColor=#fff3e0;strokeColor=#b25000;" vertex="1" parent="1"><mxGeometry x="214" y="70" width="164" height="28" as="geometry"/></mxCell><mxCell id="lg2" value="sc-db01" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#1d1d1f;fillColor=#e6f0fd;strokeColor=#0071e3;" vertex="1" parent="1"><mxGeometry x="388" y="70" width="164" height="28" as="geometry"/></mxCell><mxCell id="lg3" value="sc-registry01" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#1d1d1f;fillColor=#e6f4ea;strokeColor=#248a3d;" vertex="1" parent="1"><mxGeometry x="562" y="70" width="164" height="28" as="geometry"/></mxCell><mxCell id="lg4" value="sc-admin01" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#1d1d1f;fillColor=#f3e8f8;strokeColor=#8944ab;" vertex="1" parent="1"><mxGeometry x="736" y="70" width="164" height="28" as="geometry"/></mxCell><mxCell id="lg5" value="AI agent + operator" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#1d1d1f;fillColor=#e0f7f8;strokeColor=#0e7c86;" vertex="1" parent="1"><mxGeometry x="910" y="70" width="164" height="28" as="geometry"/></mxCell><mxCell id="lg6" value="Decision / finding" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontColor=#1d1d1f;fillColor=#f5f5f7;strokeColor=#8e8e93;" vertex="1" parent="1"><mxGeometry x="1084" y="70" width="164" height="28" as="geometry"/></mxCell><mxCell id="s" value="&lt;b&gt;06:30&lt;/b&gt; Scanners sweep the portal. &lt;code&gt;203.0.113.87&lt;/code&gt;&lt;br&gt;walks six URL schemes against &lt;code&gt;/api/v1/preview&lt;/code&gt;." style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=14;fontColor=#1d1d1f;fillColor=#fde8e8;strokeColor=#d70015;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="440" y="130" width="440" height="84" as="geometry"/></mxCell><mxCell id="q1" value="Does the preview API&lt;br&gt;allow-list URL schemes?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fontColor=#1d1d1f;fillColor=#f5f5f7;strokeColor=#8e8e93;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="254" width="360" height="120" as="geometry"/></mxCell><mxCell id="a" value="&lt;b&gt;06:52&lt;/b&gt; &lt;code&gt;gopher://&lt;/code&gt; talks to local Redis, writes a root&lt;br&gt;crontab; &lt;code&gt;cron&lt;/code&gt; runs a root reverse shell. &lt;b&gt;7 s.&lt;/b&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#1d1d1f;fillColor=#fff3e0;strokeColor=#b25000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="440" y="414" width="440" height="84" as="geometry"/></mxCell><mxCell id="b" value="&lt;b&gt;07:05&lt;/b&gt; The shell reads &lt;code&gt;portal.conf&lt;/code&gt;:&lt;br&gt;&lt;b&gt;three credentials&lt;/b&gt; (database, registry, admin API)." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#1d1d1f;fillColor=#fff3e0;strokeColor=#b25000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="440" y="538" width="440" height="84" as="geometry"/></mxCell><mxCell id="c" value="&lt;b&gt;07:16&lt;/b&gt; &lt;code&gt;portal_svc&lt;/code&gt; logs in &lt;b&gt;from the portal&lt;/b&gt;;&lt;br&gt;reads &lt;code&gt;customers&lt;/code&gt;, &lt;code&gt;information_schema&lt;/code&gt;, &lt;code&gt;pg_shadow&lt;/code&gt;." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#1d1d1f;fillColor=#e6f0fd;strokeColor=#0071e3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="440" y="662" width="440" height="84" as="geometry"/></mxCell><mxCell id="d" value="&lt;b&gt;07:33&lt;/b&gt; &lt;code&gt;ci-builder&lt;/code&gt; logs in to Harbor from the portal&lt;br&gt;(normally only the CI runner). Metadata only." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#1d1d1f;fillColor=#e6f4ea;strokeColor=#248a3d;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="440" y="786" width="440" height="84" as="geometry"/></mxCell><mxCell id="e" value="&lt;b&gt;07:45&lt;/b&gt; Admin API: &lt;code&gt;/services&lt;/code&gt;, &lt;code&gt;/topology&lt;/code&gt; 200;&lt;br&gt;&lt;code&gt;/secrets&lt;/code&gt; &lt;b&gt;403&lt;/b&gt;." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#1d1d1f;fillColor=#f3e8f8;strokeColor=#8944ab;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="440" y="910" width="440" height="84" as="geometry"/></mxCell><mxCell id="f" value="&lt;b&gt;08:02 to 08:15&lt;/b&gt; &lt;code&gt;tar&lt;/code&gt; → &lt;code&gt;gzip&lt;/code&gt; → &lt;code&gt;openssl&lt;/code&gt; archive,&lt;br&gt;POSTed to &lt;code&gt;198.51.100.210:443&lt;/code&gt;." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#1d1d1f;fillColor=#fff3e0;strokeColor=#b25000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="440" y="1034" width="440" height="84" as="geometry"/></mxCell><mxCell id="g" value="&lt;b&gt;08:29&lt;/b&gt; &lt;code&gt;svc_monitor&lt;/code&gt; created, added to sudo,&lt;br&gt;given an SSH key: a way back in." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#1d1d1f;fillColor=#fff3e0;strokeColor=#b25000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="440" y="1158" width="440" height="84" as="geometry"/></mxCell><mxCell id="z" value="&lt;b&gt;End:&lt;/b&gt; about 90 minutes across four hosts.&lt;br&gt;&lt;code&gt;customers&lt;/code&gt; data probably lost (Confidence: Medium)." style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=14;fontColor=#1d1d1f;fillColor=#fde8e8;strokeColor=#d70015;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="440" y="1282" width="440" height="84" as="geometry"/></mxCell><mxCell id="n1" value="&lt;b&gt;No.&lt;/b&gt; &lt;code&gt;file://&lt;/code&gt; is rejected (400), but&lt;br&gt;&lt;code&gt;gopher://&lt;/code&gt; is accepted (200) 18 s later.&lt;br&gt;&lt;i&gt;Fix:&lt;/i&gt; scheme allow-list; block Redis." style="rounded=1;arcSize=14;dashed=1;whiteSpace=wrap;html=1;fontSize=14;fontColor=#1d1d1f;fillColor=#f5f5f7;strokeColor=#8e8e93;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="970" y="259.0" width="320" height="110" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Two claimed wins never happened.&lt;/b&gt;&lt;br&gt;&quot;K8s secrets&quot;: the API said 403.&lt;br&gt;&quot;db_admin&quot; from an image layer: no layer&lt;br&gt;was pulled, zero rows anywhere." style="rounded=1;arcSize=14;dashed=1;whiteSpace=wrap;html=1;fontSize=14;fontColor=#1d1d1f;fillColor=#f5f5f7;strokeColor=#8e8e93;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="970" y="890.0" width="320" height="124" as="geometry"/></mxCell><mxCell id="h" value="&lt;b&gt;A human operator&lt;/b&gt; steers the AI agent&lt;br&gt;(&lt;code&gt;quartzfang-agent&lt;/code&gt;) at five decision&lt;br&gt;points between its autonomous phases." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=14;fontColor=#1d1d1f;fillColor=#e0f7f8;strokeColor=#0e7c86;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="525.0" width="320" height="110" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#3a3a3c;fontColor=#1d1d1f;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s" target="q1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#3a3a3c;fontColor=#1d1d1f;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q1" target="a"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#3a3a3c;fontColor=#1d1d1f;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a" target="b"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#3a3a3c;fontColor=#1d1d1f;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b" target="c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#3a3a3c;fontColor=#1d1d1f;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c" target="d"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#3a3a3c;fontColor=#1d1d1f;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d" target="e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#3a3a3c;fontColor=#1d1d1f;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="e" target="f"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#3a3a3c;fontColor=#1d1d1f;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f" target="g"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#3a3a3c;fontColor=#1d1d1f;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="g" target="z"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#3a3a3c;fontColor=#1d1d1f;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="q1" target="n1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#3a3a3c;fontColor=#1d1d1f;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="e" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="gates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#3a3a3c;fontColor=#1d1d1f;fontSize=13;fontStyle=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="h" target="b"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>